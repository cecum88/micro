/*
 * K:04 Micro — RU/EN вариант (аналог op36_ruen.keymap)
 * Слой Mouse включается сам при движении трекбола (zip_auto_mouse).
 */

#include "keys_ru.h"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/input_gestures_accel.dtsi>
#include <dt-bindings/zmk/mouse-gesture.h>
#include <behaviors/split_conn_ladder.dtsi>
#include <dt-bindings/zmk/split_conn_ladder.h>
#include <behaviors/ble_host_link.dtsi>
#include <dt-bindings/zmk/ble_host_link.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    input_processors {
        xy_fine: xy_fine {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_X INPUT_REL_Y>;
            track-remainders;
        };
    };

    accel_scroll: accel_scroll {
        compatible = "zmk,input-processor-acceleration";
        status = "okay";
        #input-processor-cells = <0>;
        input-type = <INPUT_EV_REL>;
        track-remainders;
        min-factor = <1000>;
        max-factor = <8000>;
        speed-threshold = <1000>;
        speed-max = <12000>;
        acceleration-exponent = <3>;
    };
};

&pointer_accel {
    input-type = <INPUT_EV_REL>;
    track-remainders;
    min-factor = <1000>;
    max-factor = <6000>;
    speed-threshold = <100>;
    speed-max = <16000>;
    acceleration-exponent = <2>;
};

/ {
    behaviors {
        zip_auto_mouse: zip_auto_mouse {
            compatible = "zmk,input-processor-temp-layer-keep";
            #input-processor-cells = <2>;
            require-prior-idle-ms = <300>;
            excluded-positions = <0 10 11 12 13 20>;
            keep-active-while-layers = <8 9 10>;
        };

        td_lang_nix: td_lang_nix {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_LANG_NIX";
            bindings = <&mo>, <&lg_tog_nix>;

            #binding-cells = <2>;
            tapping-term-ms = <125>;
        };

        mt_tog_125: mt_tog_125 {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_TOG_125";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <125>;
        };

        ht_200: ht_200 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_200";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ht_150: ht_150 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_150";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        ht_250: ht_250 {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_250";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
        };

        esc_en: esc_en {
            compatible = "zmk,behavior-tap-dance";
            label = "ESC_EN";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Q>, <&kp ESC>;
        };

        esc_ru: esc_ru {
            compatible = "zmk,behavior-tap-dance";
            label = "ESC_RU";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RU_CYRILLIC_SHORT_I>, <&kp ESC>;
        };

        mt_kp_125: mt_kp_125 {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_KP_125";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <125>;
        };

        tg_ws_win: tg_ws_win {
            compatible = "zmk,behavior-tap-dance";
            label = "TG_WS_WIN";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(LC(RIGHT))>, <&kp LG(LC(LEFT_ARROW))>;
        };

        mkp: mkp {
            compatible = "zmk,behavior-tap-dance";
            label = "MKP";
            #binding-cells = <0>;
            bindings = <&mkp MB1>, <&mkp MB2>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(N1))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(N0))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        lg_tog_nix: lg_tog_nix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS &tog 1>;
            label = "LG_TOG_NIX";
        };

        lg_tog_win: lg_tog_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT_SHIFT) &tog 1>;
            label = "LG_TOG_WIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&esc_en             &kp W                 &kp E               &kp R                   &kp T                                       &kp Y            &kp U                   &kp I               &kp O                  &kp P
&ht_200 LEFT_GUI A  &ht_200 LEFT_SHIFT S  &ht_200 LEFT_ALT D  &ht_200 LEFT_CONTROL F  &kp G                                       &kp H            &ht_200 LEFT_CONTROL J  &ht_200 LEFT_ALT K  &ht_200 RIGHT_SHIFT L  &ht_200 LEFT_GUI SEMICOLON
&kp Z               &kp X                 &ht_150 LC(INS) C   &ht_250 LS(INS) V       &kp B                                       &kp N            &kp M                   &kp COMMA           &kp DOT                &kp SQT
                                                              &mt_tog_125 6 1         &td_lang_nix 5 0  &lt 2 SPACE    &lt 2 RET  &lt 3 BACKSPACE  &mt_kp_125 6 TAB
            >;

            display-name = "EN";
        };

        ru {
            bindings = <
&esc_ru                          &kp RU_CYRILLIC_TSE                  &kp RU_CYRILLIC_U                  &kp RU_CYRILLIC_KA              &kp RU_CYRILLIC_IE                              &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE          &kp RU_CYRILLIC_SHA              &kp RU_CYRILLIC_SHCHA               &kp RU_CYRILLIC_ZE
&ht_200 LEFT_GUI RU_CYRILLIC_EF  &ht_200 LEFT_SHIFT RU_CYRILLIC_YERU  &ht_200 LEFT_ALT RU_CYRILLIC_VE    &ht_200 LCTRL RU_CYRILLIC_A     &kp RU_CYRILLIC_PE                              &kp RU_CYRILLIC_ER  &ht_200 LCTRL RU_CYRILLIC_O  &ht_200 LEFT_ALT RU_CYRILLIC_EL  &ht_200 RIGHT_SHIFT RU_CYRILLIC_DE  &ht_200 LEFT_GUI RU_CYRILLIC_ZHE
&kp RU_CYRILLIC_YA               &kp RU_CYRILLIC_CHE                  &ht_150 LC(INSERT) RU_CYRILLIC_ES  &ht_250 LS(INS) RU_CYRILLIC_EM  &kp RU_CYRILLIC_I                               &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN    &kp RU_CYRILLIC_BE               &kp RU_CYRILLIC_YU                  &kp RU_CYRILLIC_E
                                                                                                         &mt_tog_125 6 1                 &td_lang_nix 5 0    &lt 2 SPACE    &lt 2 ENTER  &lt 4 BACKSPACE     &mt_kp_125 6 TAB
            >;

            display-name = "RU";
        };

        nav {
            bindings = <
&kp C_PP    &kp N7  &kp N8  &kp N9  &kp N0                      &ht_200 LS(HOME) HOME  &kp PAGE_DOWN   &kp PAGE_UP   &ht_200 LS(END) END  &none
&kp C_STOP  &kp N4  &kp N5  &kp N6  &none                       &kp LEFT_ARROW         &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW      &none
&kp F20     &kp N1  &kp N2  &kp N3  &kp DELETE                  &none                  &none           &none         &none                &none
                            &none   &none       &none    &none  &none                  &none
            >;

            display-name = "MV";
        };

        sym_en {
            bindings = <
&kp DOLLAR  &kp LT                     &kp EQUAL  &kp GT                      &kp GRAVE                    &kp CARET    &kp DQT         &kp COLON  &kp SQT          &kp EXCL
&kp TILDE   &ht_250 LEFT_BRACKET LPAR  &kp MINUS  &ht_250 RIGHT_BRACKET RPAR  &kp PLUS                     &kp AT_SIGN  &kp LEFT_BRACE  &kp SEMI   &kp RIGHT_BRACE  &kp QMARK
&kp HASH    &kp BSLH                   &kp UNDER  &kp FSLH                    &kp ASTRK                    &kp PRCNT    &kp PIPE        &kp COMMA  &kp DOT          &kp AMPERSAND
                                                  &none                       &lg_tog_win  &none    &none  &none        &none
            >;

            display-name = "SS";
        };

        sym_ru {
            display-name = "SS";
            bindings = <
&en DOLLAR  &en LT                   &kp EQUAL          &en GT                    &kp RU_CYRILLIC_IO                  &en CARET       &kp RU_DQT      &kp RU_COLON  &en SQT          &kp EXCL
&en TILDE   &kp RU_LEFT_PARENTHESIS  &kp MINUS          &kp RU_RIGHT_PARENTHESIS  &kp RU_PLUS                         &en AT_SIGN     &en LEFT_BRACE  &kp RU_SEMI   &en RIGHT_BRACE  &kp RU_QMARK
&en HASH    &kp RU_BACKSLASH         &kp RU_UNDERSCORE  &kp RU_FSLH               &kp RU_ASTERISK                     &kp RU_PERCENT  &en PIPE        &kp RU_COMMA  &kp RU_DOT       &en AMPERSAND
                                                        &none                     &lg_tog_win         &none    &none  &none           &none
            >;
        };

        adj {
            bindings = <
&none       &kp F7  &kp F8  &kp F9  &kp F10                  &none  &none  &none  &none  &none
&none       &kp F4  &kp F5  &kp F6  &kp F11                  &none  &none  &none  &none  &none
&tg_ws_win  &kp F1  &kp F2  &kp F3  &kp F12                  &none  &none  &none  &none  &studio_unlock
                            &none   &none    &none    &none  &none  &none
            >;

            display-name = "FU";
        };

        mango {
            bindings = <
&kp LG(LC(Q))  &kp LG(LC(W))  &kp LG(LC(E))  &kp LG(LC(R))  &kp LG(LC(T))                  &kp LG(LC(Y))  &kp LG(LC(U))     &kp LG(LC(I))  &kp LG(LC(O))  &kp LG(LC(P))
&kp LG(LC(A))  &kp LG(LC(S))  &kp LG(LC(D))  &kp LG(LC(F))  &kp LG(LC(G))                  &kp LG(LC(H))  &kp LG(LC(LEFT))  &kp LG(LC(K))  &kp LG(LC(L))  &kp LG(LC(SEMI))
&kp ESC        &none          &none          &mkp MB1       &kp F17                        &kp F18        &none             &none          &none          &none
                                             &none          &none          &none    &none  &none          &none
            >;

            label = "WM";
        };

        /* Layer 11. Host link tests: intervals in 1.25 ms units, latency in
           connection events, ball reports in ms. Reach it with &to 11 (bind it
           where you like, or through ZMK Studio); &to 0 on both outer thumbs
           leaves it. */
    };
};

&trackball_listener {
    input-processors = <&pointer_accel>, <&xy_fine 2 5>;

    scroller {
        layers = <6>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&accel_scroll>,
            <&xy_fine 1 100>,
            <&zip_xy_to_scroll_mapper>;
    };
};
